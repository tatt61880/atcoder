func main()
	var n: int :: cui@inputInt()
	var s: [][]char :: #[n][]char
	var t: []int :: #[n]int
	for i(0, n - 1)
		do s[i] :: cui@inputStr()
		do t[i] :: cui@inputInt()
	end for
	
	var x: []int :: ##t
	do x.sort()
	
	for i(0, n - 1)
		if(t[i] = x[n - 2])
			do cui@print("\{s[i]}\n")
			ret
		end if
	end for
end func
