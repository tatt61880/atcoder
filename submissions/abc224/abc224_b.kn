func main()
	var h: int :: cui@inputInt()
	var w: int :: cui@inputInt()
	var a: [][]int :: #[h, w]int
	for i(0, h - 1)
		for j(0, w - 1)
			do a[i][j] :: cui@inputInt()
		end for
	end for
	
	for i1(0, h - 1)
		for j1(0, w - 1)
			for i2(i1, h - 1)
				for j2(j1, w - 1)
					if(a[i1][j1] + a[i2][j2] > a[i2][j1] + a[i1][j2])
						do cui@print("No\n")
						ret
					end if
				end for
			end for
		end for
	end for
	
	do cui@print("Yes\n")
end func
