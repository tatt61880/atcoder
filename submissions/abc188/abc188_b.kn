func main()
	var n: int :: cui@inputInt()
	var a: []int :: #[n]int
	for i(0, n - 1)
		do a[i] :: cui@inputInt()
	end for
	var b: []int :: #[n]int
	for i(0, n - 1)
		do b[i] :: cui@inputInt()
	end for
	
	var x: int :: 0
	for i(0, n - 1)
		do x :+ a[i] * b[i]
	end for
	
	var ans: bool :: x = 0
	do cui@print((ans ?("Yes", "No")) ~ "\n")
end func
