func main()
	var n: int :: cui@inputInt()
	var l: []int :: #[n]int
	var sum: int :: 0
	for i(0, n - 1)
		do l[i] :: cui@inputInt()
		do sum :+ l[i]
	end for
	
	var ans: int :: lib@intMax
	
	var sum2: int :: 0
	for i(0, n - 1)
		do sum2 :+ l[i]
		var sum3: int :: sum - sum2
		do ans :: lib@min(ans, (sum2 - sum3).abs())
	end for
	
	do cui@print("\{ans}\n")
end func
