func main()
	var n: int :: cui@inputInt()
	var m: int :: cui@inputInt()
	var t: int :: cui@inputInt()
	
	var tn: int :: 0
	var nn: int :: n
	
	var ans: bool :: true
	
	for i(0, m)
		var a: int :: i <> m ?(cui@inputInt(), t)
		var b: int :: i <> m ?(cui@inputInt(), t)
		
		do nn :- a - tn
		if(nn <= 0)
			do ans :: false
			break i
		end if
		
		do nn :: lib@min(n, nn + b - a)
		do tn :: b
	end for
	
	do cui@print((ans ?("Yes", "No")) ~ "\n")
end func
