func main()
	var n: int :: cui@inputInt()
	var a: []int :: #[n + 1]int
	
	var x: int :: 0
	do a[0] :: 0
	for i(1, n)
		do x :+ cui@inputInt()
		do a[i] :: x % 360
	end for
	
	do a.sort()
	
	var ans: int :: 360 - a[n]
	
	for i(1, n)
		do ans :: lib@max(ans, a[i] - a[i - 1])
	end for
	
	do cui@print("\{ans}\n")
end func
