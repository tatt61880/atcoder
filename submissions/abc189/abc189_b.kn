func main()
	var n: int :: cui@inputInt()
	var x: int :: cui@inputInt() * 100
	
	var ans: int :: -1
	
	var sum: int
	for i(1, n)
		var v: int :: cui@inputInt()
		var p: int :: cui@inputInt()
		do sum :+ v * p
		if(sum > x)
			do ans :: i
			break i
		end if
	end for
	
	do cui@print("\{ans}\n")
end func
