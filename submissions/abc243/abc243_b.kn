func main()
	var n: int :: cui@inputInt()
	var a: []int :: #[n]int
	for i(0, n - 1)
		do a[i] :: cui@inputInt()
	end for
	var b: []int :: #[n]int
	for i(0, n - 1)
		do b[i] :: cui@inputInt()
	end for
	
	var ans1: int :: 0
	var ans2: int :: 0
	
	for i(0, n - 1)
		for j(0, n - 1)
			if(a[i] = b[j])
				if(i = j)
					do ans1 :+ 1
				else
					do ans2 :+ 1
				end if
			end if
		end for
	end for
	
	do cui@print("\{ans1}\n")
	do cui@print("\{ans2}\n")
end func
