func main()
	var n: int :: cui@inputInt()
	var s: int :: cui@inputInt()
	var d: int :: cui@inputInt()
	
	var ans: bool :: false
	for loop(1, n)
		var x: int :: cui@inputInt()
		var y: int :: cui@inputInt()
		if(x < s & y > d)
			do ans :: true
			break loop
		end if
	end for
	do cui@print((ans ?("Yes", "No")) ~ "\n")
end func
