func main()
	var n: int :: cui@inputInt()
	var a: []int :: #[n]int
	for i(0, n - 1)
		do a[i] :: cui@inputInt()
	end for
	
	var ans: int :: 0
	var max: int :: 0
	
	for k(2, 1000)
		var cnt: int :: 0
		
		for i(0, n - 1)
			do cnt :+ a[i] % k = 0 ?(1, 0)
		end for
		
		if(cnt > max)
			do max :: cnt
			do ans :: k
		end if
	end for
	
	do cui@print("\{ans}\n")
end func
