func main()
	var dx: []int :: [0, 1, 0, -1]
	var dy: []int :: [-1, 0, 1, 0]
	
	var n: int :: cui@inputInt()
	var t: []char :: cui@input()
	
	var d: int :: 1
	var x: int :: 0
	var y: int :: 0
	for i(0, n - 1)
		if(t[i] = 'S')
			do x :+ dx[d]
			do y :+ dy[d]
		else
			do d :: (d + 3) % 4
		end if
	end for
	
	var ans: int :: 0
	do cui@print("\{x} \{y}\n")
end func
