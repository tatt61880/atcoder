func main()
	var a: int :: cui@inputInt()
	var b: int :: cui@inputInt()
	var c: int :: cui@inputInt()
	var d: int :: cui@inputInt()
	
	if(b >= c * d)
		do cui@print("-1\n")
		ret
	end if
	
	var ok: int :: a
	var ng: int :: 0
	while((ok - ng).abs() > 1)
		var mid: int :: (ok + ng) / 2
		if(a + mid * b <= d * mid * c)
			do ok :: mid
		else
			do ng :: mid
		end if
	end while
	
	var ans: int :: ok
	do cui@print("\{ans}\n")
end func
