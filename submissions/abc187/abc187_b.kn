func main()
	var n: int :: cui@inputInt()
	
	var x: []int :: #[n]int
	var y: []int :: #[n]int
	for i(0, n - 1)
		do x[i] :: cui@inputInt()
		do y[i] :: cui@inputInt()
	end for
	
	var ans: int :: 0
	
	for i(0, n - 1)
		for j(i + 1, n - 1)
			do ans :+ ((x[i] - x[j]).abs() >= (y[i] - y[j]).abs()) ?(1, 0)
		end for
	end for
	
	do cui@print("\{ans}\n")
end func
