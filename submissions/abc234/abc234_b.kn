func main()
	var n: int :: cui@inputInt()
	var x: []int :: #[n]int
	var y: []int :: #[n]int
	for i(0, n - 1)
		do x[i] :: cui@inputInt()
		do y[i] :: cui@inputInt()
	end for
	
	var ans: int :: 0
	
	for i(0, n - 1)
		for j(i + 1, n - 1)
			do ans :: lib@max(ans, (x[i] - x[j]) ^ 2 + (y[i] - y[j]) ^ 2)
		end for
	end for
	
	do cui@print("\{ans $ float ^ 0.5}\n")
end func
