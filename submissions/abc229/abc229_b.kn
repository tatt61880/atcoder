func main()
	var a: []char :: cui@inputStr()
	var b: []char :: cui@inputStr()
	
	do a.reverse()
	do b.reverse()
	
	var ans: bool :: true
	
	for i(0, lib@min(^a, ^b) - 1)
		if(a[i] $ int + b[i] $ int - '0' $ int * 2 >= 10)
			do ans :: false
			break i
		end if
	end for
	
	do cui@print((ans ?("Easy", "Hard")) ~ "\n")
end func
