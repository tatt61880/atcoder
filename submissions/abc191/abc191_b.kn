func main()
	var n: int :: cui@inputInt()
	var x: int :: cui@inputInt()
	
	var a: []int :: #[n]int
	var cnt: int :: 0
	for i(0, n - 1)
		do a[i] :: cui@inputInt()
		if(a[i] <> x)
			do cnt :+ 1
		end if
	end for
	
	if(cnt = 0)
		ret
	end if
	
	var ans: []int :: #[cnt]int
	do cnt :: 0
	for i(0, n - 1)
		if(a[i] <> x)
			do ans[cnt] :: a[i]
			do cnt :+ 1
		end if
	end for
	
	do cui@print("\{ans.join(" ")}\n")
end func
