func main()
	var n: int :: cui@inputInt()
	var a: []int :: #[n]int
	for i(0, n - 1)
		do a[i] :: cui@inputInt()
	end for
	
	var b: []int :: ##a
	do b.sort()
	
	var ans: int :: 0
	
	for i(0, n - 1)
		if(b[n - 2] = a[i])
			do ans :: i + 1
			break i
		end if
	end for
	
	do cui@print("\{ans}\n")
end func
